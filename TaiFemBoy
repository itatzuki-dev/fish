	Z=false,
	X=false,
	C=false,
	V=false
}

local ScreenGui
local Main
local Mini

local function Connect(signal,callback)
	local c=signal:Connect(callback)
	table.insert(Connections,c)
	return c
end

local function DisconnectAll()
	for _,c in ipairs(Connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(Connections)
end

local function StopSkill(skill)
	SkillTokens[skill]+=1
	SkillRunning[skill]=false
end

local function StopAllSkills()
	for skill in pairs(SkillRunning) do
		StopSkill(skill)
	end
end

function Controller.Stop()
	if not Running then
		return
	end

	Running=false

	Settings.AutoFishing=false
	Settings.BarFreeze=false
	Settings.PlayerFreeze=false
	Settings.Z=false
	Settings.X=false
	Settings.C=false
	Settings.V=false

	ToolReady=false
	Bar=nil
	FrozenBarPosition=nil
	FreezeCFrame=nil

	StopAllSkills()
	DisconnectAll()

	if ScreenGui then
		pcall(function()
			ScreenGui:Destroy()
		end)
		ScreenGui=nil
	end

	if _G.ZNiggaController==Controller then
		_G.ZNiggaController=nil
	end
end

local function GetCharacter()
	return Player.Character
end

local function GetRoot()
	local Character=GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChild("HumanoidRootPart")
end

local function HasTool()
	local Character=GetCharacter()

	if not Character then
		return false
	end

	return Character:FindFirstChild("Tool")~=nil
end

local function PressOne()
	if not Running then
		return
	end

	pcall(function()
		VirtualInputManager:SendKeyEvent(
			true,
			Enum.KeyCode.One,
			false,
			game
		)

		task.wait(0.05)

		VirtualInputManager:SendKeyEvent(
			false,
			Enum.KeyCode.One,
			false,
			game
		)
	end)
end

local function FindBar()
	local MainGui=PlayerGui:FindFirstChild("MainGui")

	if not MainGui then
		return nil
	end

	local Fishing=MainGui:FindFirstChild("Fishing")

	if not Fishing then
		return nil
	end

	local BarFrame=Fishing:FindFirstChild("BarFrame")

	if not BarFrame then
		return nil
	end

	local Found=BarFrame:FindFirstChild("Bar")

	if Found and Found:IsA("GuiObject") then
		return Found
	end

	return nil
end

local function EnableBarFreeze()
	Bar=FindBar()

	if Bar then
		FrozenBarPosition=Bar.Position
	end
end

local function DisableBarFreeze()
	FrozenBarPosition=nil
	Bar=nil
end

local function ApplyBarFreeze()
	if not Running or not Settings.BarFreeze then
		return
	end

	if not Bar or not Bar.Parent then
		Bar=FindBar()

		if Bar then
			FrozenBarPosition=Bar.Position
		end
	end

	if Bar and FrozenBarPosition then
		Bar.Position=FrozenBarPosition
	end
end

local function EnablePlayerFreeze()
	local Root=GetRoot()

	if Root then
		FreezeCFrame=Root.CFrame
	end
end

local function DisablePlayerFreeze()
	FreezeCFrame=nil

	local Root=GetRoot()

	if Root then
		pcall(function()
			Root.AssemblyLinearVelocity=Vector3.zero
			Root.AssemblyAngularVelocity=Vector3.zero
		end)
	end
end

local function ApplyPlayerFreeze()
	if not Running or not Settings.PlayerFreeze then
		return
	end

	if not FreezeCFrame then
		EnablePlayerFreeze()
	end

	local Root=GetRoot()

	if Root and FreezeCFrame then
		pcall(function()
			Root.CFrame=FreezeCFrame
			Root.AssemblyLinearVelocity=Vector3.zero
			Root.AssemblyAngularVelocity=Vector3.zero
		end)
	end
end

Connect(RunService.RenderStepped,function()
	if Running and Settings.BarFreeze then
		ApplyBarFreeze()
	end
end)

Connect(RunService.Heartbeat,function()
	if Running and Settings.PlayerFreeze then
		ApplyPlayerFreeze()
	end
end)

local function GetFishingCFrame()
	local Character=GetCharacter()

	if not Character then
		return nil
	end

	local Root=Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return nil
	end

	local Look=Root.CFrame.LookVector

	local Direction=Vector3.new(
		Look.X,
		0,
		Look.Z
	)

	if Direction.Magnitude<=0.001 then
		return nil
	end

	Direction=Direction.Unit

	local Position=
		Root.Position+
		Direction*FISH_DISTANCE

	Position=Vector3.new(
		Position.X,
		Root.Position.Y,
		Position.Z
	)

	return CFrame.lookAt(
		Position,
		Position+Direction
	)
end

local function StartSkill(Skill)
	if not Running then
		return
	end

	if not Settings[Skill] then
		return
	end

	if not Settings.AutoFishing then
		return
	end

	if not ToolReady or not HasTool() then
		return
	end

	StopSkill(Skill)

	local Token=SkillTokens[Skill]

	task.spawn(function()
		task.wait(SKILL_START_DELAY)

		if not Running
			or not Settings[Skill]
			or not Settings.AutoFishing
			or not ToolReady
			or not HasTool()
			or Token~=SkillTokens[Skill] then
			return
		end

		SkillRunning[Skill]=true

		while Running
			and Settings[Skill]
			and Settings.AutoFishing
			and ToolReady
			and HasTool()
			and Token==SkillTokens[Skill] do

			pcall(function()
				UseSkill:FireServer(Skill)
			end)

			task.wait(SKILL_INTERVAL)
		end

		SkillRunning[Skill]=false
	end)
end

local function StartEnabledSkills()
	if not Settings.AutoFishing then
		return
	end

	if not ToolReady or not HasTool() then
		return
	end

	for Skill in pairs(SkillRunning) do
		if Settings[Skill] then
			StartSkill(Skill)
		end
	end
end

local function StartFishing()
	if not Running or not Settings.AutoFishing then
		return
	end

	if not ToolReady or not HasTool() then
		return
	end

	local FishingCFrame=GetFishingCFrame()

	if not FishingCFrame then
		return
	end

	pcall(function()
		FishingEvent:FireServer(FishingCFrame)
	end)

	StartEnabledSkills()
end

local function CheckTool()
	if not Running then
		return
	end

	if not Settings.AutoFishing then
		ToolReady=false
		StopAllSkills()
		return
	end

	if HasTool() then
		if not ToolReady then
			ToolReady=true

			task.wait(0.1)

			if Running
				and Settings.AutoFishing
				and HasTool() then

				StartFishing()
			end
		end

		return
	end

	ToolReady=false
	StopAllSkills()

	local Now=os.clock()

	if Now-LastToolCheck<TOOL_CHECK_INTERVAL then
		return
	end

	LastToolCheck=Now

	PressOne()
end

Connect(FishingMinigame.OnClientEvent,function(...)
	if not Running then
		return
	end

	local Args={...}

	if Args[1]~="SessionEnd" then
		return
	end

	StopAllSkills()

	if not Settings.AutoFishing then
		return
	end

	task.wait(0.1)

	if not Running then
		return
	end

	if HasTool() then
		ToolReady=true
		StartFishing()
	else
		ToolReady=false
	end
end)

task.spawn(function()
	while Running do
		CheckTool()
		task.wait(TOOL_CHECK_INTERVAL)
	end
end)

Connect(Player.CharacterAdded,function()
	if not Running then
		return
	end

	ToolReady=false
	LastToolCheck=0
	StopAllSkills()
	FreezeCFrame=nil

	task.wait(0.5)

	if Running and Settings.AutoFishing then
		CheckTool()
	end
end)

