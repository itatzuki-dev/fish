local FISH_DISTANCE = 5
local TOOL_CHECK_INTERVAL = 1
local SKILL_START_DELAY = 5
local SKILL_INTERVAL = 0.1
local STRONGEST_ROD_INTERVAL = 1
local AUTO_SELL_INTERVAL = 10

local Running = true
local ToolReady = false
local LastToolCheck = 0

local Bar = nil
local FrozenBarPosition = nil
local FreezeCFrame = nil

local Connections = {}

local Settings = {
	AutoFishing = false,
	StrongestRod = false,
	BarFreeze = false,
	PlayerFreeze = false,
	AutoSell = false,
	Z = false,
	X = false,
	C = false,
	V = false,
}

local SkillOrder = {
	Z = 1,
	X = 2,
	C = 3,
	V = 4,
}

local SkillTokens = {
	Z = 0,
	X = 0,
	C = 0,
	V = 0,
}

local function Connect(signal, callback)
	local Connection = signal:Connect(callback)
	table.insert(Connections, Connection)
	return Connection
end

local function DisconnectAll()
	for _, Connection in ipairs(Connections) do
		pcall(function()
			Connection:Disconnect()
		end)
	end

	table.clear(Connections)
end

local function GetCharacter()
	return Player.Character
end

local function GetRoot()
	local Character = GetCharacter()

	if not Character then
		return nil
	end

	return Character:FindFirstChild("HumanoidRootPart")
end

local function HasTool()
	local Character = GetCharacter()

	if not Character then
		return false
	end

	return Character:FindFirstChild("Tool") ~= nil
end

local function PressOne()
	if not Running then
		return
	end

	pcall(function()
		VirtualInputManager:SendKeyEvent(
			true,
			Enum.KeyCode.One,
			false,
			game
		)

		task.wait(0.05)

		VirtualInputManager:SendKeyEvent(
			false,
			Enum.KeyCode.One,
			false,
			game
		)
	end)
end

local function FindBar()
	local MainGui = PlayerGui:FindFirstChild("MainGui")

	if not MainGui then
		return nil
	end

	local Fishing = MainGui:FindFirstChild("Fishing")

	if not Fishing then
		return nil
	end

	local BarFrame = Fishing:FindFirstChild("BarFrame")

	if not BarFrame then
		return nil
	end

	local Found = BarFrame:FindFirstChild("Bar")

	if Found and Found:IsA("GuiObject") then
		return Found
	end

	return nil
end

local function EnableBarFreeze()
	Bar = FindBar()

	if Bar then
		FrozenBarPosition = Bar.Position
	end
end

local function DisableBarFreeze()
	FrozenBarPosition = nil
	Bar = nil
end

local function ApplyBarFreeze()
	if not Running or not Settings.BarFreeze then
		return
	end

	if not Bar or not Bar.Parent then
		Bar = FindBar()

		if Bar then
			FrozenBarPosition = Bar.Position
		end
	end

	if Bar and FrozenBarPosition then
		Bar.Position = FrozenBarPosition
	end
end

local function EnablePlayerFreeze()
	local Root = GetRoot()

	if Root then
		FreezeCFrame = Root.CFrame
	end
end

local function DisablePlayerFreeze()
	FreezeCFrame = nil

	local Root = GetRoot()

	if Root then
		pcall(function()
			Root.AssemblyLinearVelocity = Vector3.zero
			Root.AssemblyAngularVelocity = Vector3.zero
		end)
	end
end

local function ApplyPlayerFreeze()
	if not Running or not Settings.PlayerFreeze then
		return
	end

	if not FreezeCFrame then
		EnablePlayerFreeze()
	end

	local Root = GetRoot()

	if Root and FreezeCFrame then
		pcall(function()
			Root.CFrame = FreezeCFrame
			Root.AssemblyLinearVelocity = Vector3.zero
			Root.AssemblyAngularVelocity = Vector3.zero
		end)
	end
end

local function GetFishingCFrame()
	local Character = GetCharacter()

	if not Character then
		return nil
	end

	local Root = Character:FindFirstChild("HumanoidRootPart")

	if not Root then
		return nil
	end

	local Look = Root.CFrame.LookVector

	local Direction = Vector3.new(
		Look.X,
		0,
		Look.Z
	)

	if Direction.Magnitude <= 0.001 then
		return nil
	end

	Direction = Direction.Unit

	local Position = Root.Position + Direction * FISH_DISTANCE

	Position = Vector3.new(
		Position.X,
		Root.Position.Y,
		Position.Z
	)

	return CFrame.lookAt(
		Position,
		Position + Direction
	)
end

local function FindStrongestRod()
	if not Running then
		return nil, nil
	end

	local FisherGUI = PlayerGui:FindFirstChild("Fisher_GUI")

	if not FisherGUI then
		return nil, nil
	end

	local Fisher = FisherGUI:FindFirstChild("Fisher")

	if not Fisher then
		return nil, nil
	end

	local Inventory = Fisher:FindFirstChild("Fisher_Inventory")

	if not Inventory then
		return nil, nil
	end

	local Menu = Inventory:FindFirstChild("Menu")

	if not Menu then
		return nil, nil
	end

	local RodFolder = Menu:FindFirstChild("Rod")

	if not RodFolder then
		return nil, nil
	end

	local StrongestRod = nil
	local StrongestPower = -math.huge

	for _, Rod in ipairs(RodFolder:GetChildren()) do
		if not Rod:IsA("Frame") then
			continue
		end

		if not Rod.Name:lower():find("rod", 1, true) then
			continue
		end

		if Rod.Visible ~= true then
			continue
		end

		local Frame = Rod:FindFirstChild("Frame")

		if not Frame then
			continue
		end

		local PowerLabel = Frame:FindFirstChild("Power")

		if not PowerLabel then
			continue
		end

		if not PowerLabel:IsA("TextLabel") then
			continue
		end

		local Power = tonumber(
			PowerLabel.Text:match("Power:%s*(%d+)")
		)

		if not Power then
			continue
		end

		if Power > StrongestPower then
			StrongestPower = Power
			StrongestRod = Rod
		end
	end

	return StrongestRod, StrongestPower
end

local function EquipStrongestRod()
	if not Running or not Settings.StrongestRod then
		return
	end

	local StrongestRod, StrongestPower = FindStrongestRod()

	if not StrongestRod or not StrongestPower then
		return
	end

	local Character = GetCharacter()

	if not Character then
		return
	end

	local CurrentRod = nil

	for _, Child in ipairs(Character:GetChildren()) do
		if Child:IsA("Tool") then
			CurrentRod = Child
			break
		end
	end

	local CurrentPower = -math.huge

	if CurrentRod then
		local FisherGUI = PlayerGui:FindFirstChild("Fisher_GUI")

		if FisherGUI then
			local Fisher = FisherGUI:FindFirstChild("Fisher")

			if Fisher then
				local Inventory = Fisher:FindFirstChild("Fisher_Inventory")

				if Inventory then
					local Menu = Inventory:FindFirstChild("Menu")

					if Menu then
						local RodFolder = Menu:FindFirstChild("Rod")

						if RodFolder then
							local RodData = RodFolder:FindFirstChild(CurrentRod.Name)

							if RodData then
								local Frame = RodData:FindFirstChild("Frame")

								if Frame then
									local PowerLabel = Frame:FindFirstChild("Power")

									if PowerLabel and PowerLabel:IsA("TextLabel") then
										CurrentPower = tonumber(
											PowerLabel.Text:match("Power:%s*(%d+)")
										) or -math.huge
									end
								end
							end
						end
					end
				end
			end
		end
	end

	if CurrentPower < StrongestPower then
		pcall(function()
			EquipFishingRod:InvokeServer(StrongestRod.Name)
		end)

		task.wait(0.1)
	end

	if not HasTool() then
		for _ = 1, 20 do
			if not Running or not Settings.StrongestRod then
				break
			end

			if HasTool() then
				break
			end

			PressOne()
			task.wait(0.1)
		end
	end
end

local function SellAll()
	if not Running then
		return
	end

	pcall(function()
		SellFish:FireServer("All")
	end)
end

local function StopSkill(Skill)
	SkillTokens[Skill] += 1
end

local function StopAllSkills()
	for Skill in pairs(SkillTokens) do
		StopSkill(Skill)
	end
end

local function StartSkill(Skill)
	if not Running
		or not Settings[Skill]
		or not Settings.AutoFishing
		or not ToolReady
		or not HasTool() then
		return
	end

	StopSkill(Skill)

	local Token = SkillTokens[Skill]

	task.spawn(function()
		task.wait(SKILL_START_DELAY)

		if not Running
			or not Settings[Skill]
			or not Settings.AutoFishing
			or not ToolReady
			or not HasTool()
			or Token ~= SkillTokens[Skill] then
			return
		end

		while Running
			and Settings[Skill]
			and Settings.AutoFishing
			and ToolReady
			and HasTool()
			and Token == SkillTokens[Skill] do

			pcall(function()
				UseSkill:FireServer(Skill)
			end)

			task.wait(SKILL_INTERVAL)
		end
	end)
end

local function StartEnabledSkills()
	if not Settings.AutoFishing then
		return
	end

	if not ToolReady or not HasTool() then
		return
	end

	local OrderedSkills = {}

	for Skill in pairs(SkillOrder) do
		if Settings[Skill] then
			table.insert(OrderedSkills, Skill)
		end
	end

	table.sort(OrderedSkills, function(A, B)
		return SkillOrder[A] < SkillOrder[B]
	end)

	for _, Skill in ipairs(OrderedSkills) do
		StartSkill(Skill)
	end
end

local function StartFishing()
	if not Running or not Settings.AutoFishing then
		return
	end

	if Settings.StrongestRod then
		EquipStrongestRod()
		task.wait(0.15)
	end

	if not ToolReady or not HasTool() then
		return
	end

	local FishingCFrame = GetFishingCFrame()

	if not FishingCFrame then
		return
	end

	pcall(function()
		FishingEvent:FireServer(FishingCFrame)
	end)

	StartEnabledSkills()
end

local function CheckTool()
	if not Running then
		return
	end

	if not Settings.AutoFishing then
		ToolReady = false
		StopAllSkills()
		return
	end

	if HasTool() then
		if not ToolReady then
			ToolReady = true

			task.wait(0.1)

			if Running
				and Settings.AutoFishing
				and HasTool() then
				StartFishing()
			end
		end

		return
	end

	ToolReady = false
	StopAllSkills()

	local Now = os.clock()

	if Now - LastToolCheck < TOOL_CHECK_INTERVAL then
		return
	end

	LastToolCheck = Now

	PressOne()
end

Connect(RunService.RenderStepped, function()
	if Running and Settings.BarFreeze then
		ApplyBarFreeze()
	end
end)

Connect(RunService.Heartbeat, function()
	if Running and Settings.PlayerFreeze then
		ApplyPlayerFreeze()
	end
end)

Connect(FishingMinigame.OnClientEvent, function(...)
	if not Running then
		return
	end

	local Args = {...}

	if Args[1] ~= "SessionEnd" then
		return
	end

	StopAllSkills()

	if not Settings.AutoFishing then
		return
	end

	task.wait(0.1)

	if not Running then
		return
	end

	if HasTool() then
		ToolReady = true
		StartFishing()
	else
		ToolReady = false
	end
end)

Connect(ReadyTimeFX.OnClientEvent, function(...)
	if not Running then
		return
	end

	local Args = {...}

	if Args[1] ~= "LOCK" then
		return
	end

	if not Settings.AutoFishing then
		return
	end

	StartEnabledSkills()
end)

Connect(Player.CharacterAdded, function()
	if not Running then
		return
	end

	ToolReady = false
	LastToolCheck = 0
	StopAllSkills()
	FreezeCFrame = nil

	task.wait(0.5)

	if Running and Settings.AutoFishing then
		CheckTool()
	end
end)

task.spawn(function()
	while Running do
		CheckTool()
		task.wait(TOOL_CHECK_INTERVAL)
	end
end)

task.spawn(function()
	while Running do
		if Settings.StrongestRod then
			EquipStrongestRod()
		end

		task.wait(STRONGEST_ROD_INTERVAL)
	end
end)

task.spawn(function()
	while Running do
		if Settings.AutoSell then
			SellAll()
		end

		task.wait(AUTO_SELL_INTERVAL)
	end
end)

