    AutoFishEnabled = false
    AutoFishTaskId += 1

    if wasEnabled then
        pcall(function()
            FishingMinigameEvent:FireServer(false, "", "Unequip")
        end)
    end
end

-- Auto chiêu tạm nghỉ khi SessionEnd và tự chạy lại khi nhận LOCK tiếp theo.
local AutoSkillEnabled = false
local SkillSequence = ""
local SkillSequenceVersion = 0
local AutoSkillTaskId = 0
local UseSkillEvent = EventsFolder:WaitForChild("UseSkill")
local SkillLoopArmed = false
local SkillForceNext = false
local SkillSequenceResetVersion = 0
local SkillStartAfter = 0
local ReadyTimeFXEvent = EventsFolder:WaitForChild("ReadyTimeFX")
local ReadyTimeFXConnection = ReadyTimeFXEvent.OnClientEvent:Connect(function(state)
    if state == "LOCK" then
        SkillLoopArmed = true
        SkillForceNext = true
        SkillStartAfter = os.clock() + 1
    end
end)

local function StopAutoSkill(reason)
    if AutoSkillEnabled then
        AutoSkillEnabled = false
        AutoSkillTaskId += 1
    end
end

local FishingMinigameConnection = FishingMinigameEvent.OnClientEvent:Connect(function(state, success)
    if state == "SessionEnd" then
        SkillLoopArmed = false
        SkillForceNext = false
        SkillSequenceResetVersion += 1
    end
end)

