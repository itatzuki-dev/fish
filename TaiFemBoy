local function AcceptHardTicketQuest()
if not Running or not Settings.AutoTicketQuest then
return
end

if FindHardTicketQuest() then
	return
end

pcall(function()
	local NPC =
		workspace.NPC.Function:FindFirstChild(
			"Ticket Quest Giver"
		)

	if not NPC then
		return
	end

	ChooseDialogueOption:FireServer(
		"Ticket Quest Giver",
		2,
		"HardAcceptQuest",
		{
			NPC,
			"Ticket Quest"
		}
	)
end)

end

local function GetHardQuestProgress()
local HardQuest = FindHardTicketQuest()

if not HardQuest then
	return nil, nil
end

local QuestFrame =
	HardQuest:FindFirstChild(
		"Quest",
		true
	)

if not QuestFrame then
	return nil, nil
end

for _, Object in ipairs(QuestFrame:GetDescendants()) do
	if not Object:IsA("TextLabel") then
		continue
	end

	if Object.Name == "Stats"
		or Object.Name == "Tittle" then
		continue
	end

	local Current, Required =
		Object.Text:match(
			"%((%d+)%s*/%s*(%d+)%)"
		)

	if Current and Required then
		return tonumber(Current), tonumber(Required)
	end
end

return nil, nil

end

local function CompleteHardTicketQuest()
if not Running or not Settings.AutoTicketQuest then
return
end

if not FindHardTicketQuest() then
	return
end

local Current, Required =
	GetHardQuestProgress()

if not Current or not Required then
	return
end

if Current < Required then
	return
end

pcall(function()
	local NPC =
		workspace.NPC.Function:FindFirstChild(
			"Ticket Quest Giver"
		)

	if not NPC then
		return
	end

	ChooseDialogueOption:FireServer(
		"Ticket Quest Giver",
		1,
		"Quest",
		{
			NPC
		}
	)
end)

end

local function StartTicketQuest()
if QuestConnection then
QuestConnection:Disconnect()
QuestConnection = nil
end

local LastCheck = 0

QuestConnection =
	RunService.Heartbeat:Connect(function()
		if not Running
			or not Settings.AutoTicketQuest then
			return
		end

		if os.clock() - LastCheck < 1 then
			return
		end

		LastCheck = os.clock()

		if FindHardTicketQuest() then
			pcall(CompleteHardTicketQuest)
		else
			pcall(AcceptHardTicketQuest)
		end
	end)

end

local function StopTicketQuest()
if QuestConnection then
QuestConnection:Disconnect()
QuestConnection = nil
end
end

