})

AutoFishSection:Input({
    Title = "Chiêu",
    Placeholder = "Ví dụ: zxcv / z, x, c, v / V-X-C-Z",
    Callback = function(value)
        -- Chấp nhận chữ thường/hoa, viết liền hoặc ngăn cách bằng dấu.
        -- Loại bỏ mọi ký tự ngoài z, x, c, v và giữ đúng thứ tự người chơi nhập.
        local filtered = string.lower(tostring(value or "")):gsub("[^zxcv]", "")
        SkillSequence = filtered:sub(1, 4)
        SkillSequenceVersion += 1
    end,
})

AutoFishSection:Toggle({
    Title = "Auto chiêu",
    Value = false,
    Callback = function(value)
        AutoSkillTaskId += 1
        local thisTaskId = AutoSkillTaskId
        AutoSkillEnabled = value

        if not value then
            return
        end

        if SkillSequence == "" then
            AutoSkillEnabled = false
            warn("[Auto chiêu] Hãy nhập ít nhất một chữ trong z, x, c, v trước khi bật.")
            return
        end

        task.spawn(function()
            local sequenceIndex = 1
            local activeSequenceVersion = SkillSequenceVersion
            local activeResetVersion = SkillSequenceResetVersion
            while AutoSkillEnabled and AutoSkillTaskId == thisTaskId do
                if activeResetVersion ~= SkillSequenceResetVersion then
                    activeResetVersion = SkillSequenceResetVersion
                    sequenceIndex = 1
                end
                if not SkillLoopArmed or os.clock() < SkillStartAfter then
                    task.wait(0.05)
                    continue
                end

                -- Nếu người chơi sửa chuỗi khi đang chạy, bắt đầu lại từ chữ đầu tiên.
                if activeSequenceVersion ~= SkillSequenceVersion then
                    activeSequenceVersion = SkillSequenceVersion
                    sequenceIndex = 1
                end

                local character = LocalPlayer.Character
                if not character or not character.Parent then
                    task.wait(0.1)
                    continue
                end

                -- LOCK cho phép thử dùng ngay một chiêu kể cả khi SkillLocked chưa cập nhật;
                -- các chiêu kế tiếp vẫn chờ trạng thái khóa được nhả.
                local locked = character:GetAttribute("SkillLocked")
                if locked ~= true or SkillForceNext then
                    SkillForceNext = false
                    local letter = SkillSequence:sub(sequenceIndex, sequenceIndex)
                    if letter == "" then
                        sequenceIndex = 1
                        letter = SkillSequence:sub(sequenceIndex, sequenceIndex)
                    end

                    if letter ~= "" then
                        -- Mỗi lần FireServer chỉ gửi đúng một chữ, ví dụ "Z".
                        local singleSkill = string.upper(letter)
                        local ok, err = pcall(function()
                            UseSkillEvent:FireServer(singleSkill)
                        end)

                        if ok then
                            sequenceIndex += 1
                            if sequenceIndex > #SkillSequence then
                                sequenceIndex = 1
                            end
                            -- Chờ ngắn để xem SkillLocked có chuyển true sau khi dùng chiêu không.
                            -- Nếu không chuyển true trong 0.4 giây, bỏ qua ngay sang chiêu kế tiếp.
                            local sawLocked = false
                            local waitStartedAt = os.clock()
                            while AutoSkillEnabled and AutoSkillTaskId == thisTaskId
                                and os.clock() - waitStartedAt < 0.4 do
                                task.wait(0.05)
                                character = LocalPlayer.Character
                                if not character or not character.Parent then
                                    break
                                end
                                if character:GetAttribute("SkillLocked") == true then
                                    sawLocked = true
                                    break
                                end
                            end

                            if sawLocked then
                                -- Nếu khóa có bật, chờ được nhả rồi mới dùng chiêu tiếp theo.
                                local unlockStartedAt = os.clock()
                                while AutoSkillEnabled and AutoSkillTaskId == thisTaskId
                                    and os.clock() - unlockStartedAt < 3 do
                                    task.wait(0.05)
                                    character = LocalPlayer.Character
                                    if not character or not character.Parent
                                        or character:GetAttribute("SkillLocked") ~= true then
                                        break
                                    end
                                end
                            else
                            end
                        else
                            warn("[Auto chiêu] UseSkill lỗi:", err)
                            task.wait(0.2)
                        end
                    end
                else
                    task.wait(0.05)
                end
            end
        end)
    end,
})


