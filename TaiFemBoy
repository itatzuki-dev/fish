local function WaitForTool()
while Running do
if HasTool() then
return true
end

	PressOne()

	local Start = os.clock()

	while Running and os.clock() - Start < 1 do
		if HasTool() then
			return true
		end

		RunService.Heartbeat:Wait()
	end
end

return false

end

local function GetFishingCFrame()
local Root = GetRoot()

if not Root then
	return nil
end

local Position = Root.Position
local Look = Root.CFrame.LookVector

local Direction = Vector3.new(
	Look.X,
	0,
	Look.Z
)

if Direction.Magnitude <= 0 then
	return nil
end

Direction = Direction.Unit

local Target = Position + Direction * 5

return CFrame.lookAt(
	Vector3.new(
		Target.X,
		Position.Y,
		Target.Z
	),
	Vector3.new(
		Target.X + Direction.X,
		Position.Y,
		Target.Z + Direction.Z
	)
)

end

local function StopFishing()
FishingSession += 1
FishingActive = false
end

local function StartFishing()
if not Running then
return
end

if not Settings.AutoFishing then
	return
end

if FishingActive then
	return
end

if not HasTool() then
	if not WaitForTool() then
		return
	end
end

if FishingActive then
	return
end

local FishingCFrame = GetFishingCFrame()

if not FishingCFrame then
	return
end

FishingActive = true
FishingSession += 1

local MySession = FishingSession

pcall(function()
	FishingEvent:FireServer(FishingCFrame)
end)

task.spawn(function()
	local StartTime = os.clock()

	while Running
		and Settings.AutoFishing
		and FishingActive
		and MySession == FishingSession do

		if os.clock() - StartTime >= 15 then
			if MySession == FishingSession then
				FishingActive = false
			end

			break
		end

		RunService.Heartbeat:Wait()
	end
end)

end

local function StopSkills()
SkillLoopToken += 1
end

local function GetEnabledSkills()
local Skills = {}

for _, Skill in ipairs({"Z", "X", "C", "V"}) do
	if Settings[Skill] then
		table.insert(Skills, Skill)
	end
end

table.sort(Skills, function(A, B)
	return (SkillOrder[A] or 1) < (SkillOrder[B] or 1)
end)

return Skills

end

local function RunSkillSequence()
if not Running then
return
end

if not Settings.AutoFishing then
	return
end

local Skills = GetEnabledSkills()

if #Skills == 0 then
	return
end

SkillLoopToken += 1

local MyToken = SkillLoopToken

task.spawn(function()
	for _, Skill in ipairs(Skills) do
		if not Running then
			return
		end

		if not Settings.AutoFishing then
			return
		end

		if not Settings[Skill] then
			continue
		end

		if MyToken ~= SkillLoopToken then
			return
		end

		pcall(function()
			UseSkill:FireServer(Skill)
		end)

		task.wait(0.1)

		while Running
			and Settings.AutoFishing
			and Settings[Skill]
			and MyToken == SkillLoopToken do

			pcall(function()
				UseSkill:FireServer(Skill)
			end)

			task.wait(0.1)
		end

		if MyToken ~= SkillLoopToken then
			return
		end
	end
end)

end

