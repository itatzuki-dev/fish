local function CreateToggle(Text,Key,Order)
	local Holder=Instance.new("Frame")
	Holder.Name=Key
	Holder.Size=UDim2.new(1,0,0,38)
	Holder.LayoutOrder=Order
	Holder.BackgroundColor3=Color3.fromRGB(30,30,30)
	Holder.BorderSizePixel=0
	Holder.Parent=Content

	local Corner=Instance.new("UICorner")
	Corner.CornerRadius=UDim.new(0,8)
	Corner.Parent=Holder

	local Label=Instance.new("TextLabel")
	Label.Size=UDim2.new(1,-75,1,0)
	Label.Position=UDim2.fromOffset(12,0)
	Label.BackgroundTransparency=1
	Label.Text=Text
	Label.TextColor3=Color3.fromRGB(230,230,230)
	Label.TextSize=13
	Label.Font=Enum.Font.GothamMedium
	Label.TextXAlignment=Enum.TextXAlignment.Left
	Label.Active=false
	Label.Selectable=false
	Label.Parent=Holder

	local State=Instance.new("TextLabel")
	State.Size=UDim2.fromOffset(55,38)
	State.Position=UDim2.new(1,-60,0,0)
	State.BackgroundTransparency=1
	State.Text="OFF"
	State.TextColor3=Color3.fromRGB(130,130,130)
	State.TextSize=11
	State.Font=Enum.Font.GothamBold
	State.Active=false
	State.Selectable=false
	State.Parent=Holder

	local Click=Instance.new("TextButton")
	Click.Size=UDim2.fromScale(1,1)
	Click.Position=UDim2.fromScale(0,0)
	Click.BackgroundTransparency=1
	Click.BorderSizePixel=0
	Click.Text=""
	Click.AutoButtonColor=false
	Click.Selectable=false
	Click.Active=true
	Click.ZIndex=10
	Click.Parent=Holder

	Click.Activated:Connect(function()
		if not Running then
			return
		end

		Settings[Key]=not Settings[Key]

		if Settings[Key] then
			State.Text="ON"
			State.TextColor3=Color3.fromRGB(100,220,130)
		else
			State.Text="OFF"
			State.TextColor3=Color3.fromRGB(130,130,130)
		end

		if Key=="AutoFishing" then
			if Settings.AutoFishing then
				CheckTool()
			else
				ToolReady=false
				StopAllSkills()
			end

		elseif Key=="BarFreeze" then
			if Settings.BarFreeze then
				EnableBarFreeze()
			else
				DisableBarFreeze()
			end

		elseif Key=="PlayerFreeze" then
			if Settings.PlayerFreeze then
				EnablePlayerFreeze()
			else
				DisablePlayerFreeze()
			end

		elseif Key=="Z"
			or Key=="X"
			or Key=="C"
			or Key=="V" then

			if Settings[Key] then
				StartSkill(Key)
			else
				StopSkill(Key)
			end
		end
	end)
end

