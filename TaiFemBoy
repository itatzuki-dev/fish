local function SetMenuFrameVisible(frameName, buttonTitle)
    local success, err = pcall(function()
        local playerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
        assert(playerGui, "Không tìm thấy PlayerGui")
        local mainGui = playerGui:WaitForChild("MainGui", 10)
        assert(mainGui, "Không tìm thấy MainGui")
        local menu = mainGui:WaitForChild("Menu", 10)
        assert(menu, "Không tìm thấy Menu")
        local targetFrame = menu:WaitForChild(frameName, 10)
        assert(targetFrame, "Không tìm thấy Menu." .. frameName)
        assert(targetFrame:IsA("GuiObject"), "Menu." .. frameName .. " không phải GuiObject")
        targetFrame.Visible = true
    end)

    if not success then
        warn("[Shop] Không thể mở " .. buttonTitle .. ":", err)
    end
end

