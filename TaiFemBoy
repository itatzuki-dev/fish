local TargetPosition = UDim2.new(0.5, 0, 0.5, 0)

local FreezeEnabled = false
local PositionConnection = nil
local BarFrame = nil
local UpdatingPosition = false

local function GetBar()
    local PlayerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not PlayerGui then
        return nil
    end

    local MainGui = PlayerGui:FindFirstChild("MainGui")
    if not MainGui then
        return nil
    end

    local Fishing = MainGui:FindFirstChild("Fishing")
    if not Fishing then
        return nil
    end

    local BarContainer = Fishing:FindFirstChild("BarFrame")
    if not BarContainer then
        return nil
    end

    return BarContainer:FindFirstChild("Bar")
end

local function StopFreeze()
    FreezeEnabled = false

    if PositionConnection then
        PositionConnection:Disconnect()
        PositionConnection = nil
    end
end

local function StartFreeze()
    local bar = GetBar()
    if not bar or not bar:IsA("GuiObject") then
        warn("[Freeze bar] Không tìm thấy PlayerGui.MainGui.Fishing.BarFrame.Bar")
        return false
    end

    if PositionConnection then
        PositionConnection:Disconnect()
        PositionConnection = nil
    end

    BarFrame = bar
    FreezeEnabled = true
    UpdatingPosition = true
    BarFrame.Position = TargetPosition
    UpdatingPosition = false

    PositionConnection = BarFrame:GetPropertyChangedSignal("Position"):Connect(function()
        if not FreezeEnabled or not BarFrame or not BarFrame.Parent then
            return
        end

        if UpdatingPosition then
            return
        end

        if BarFrame.Position ~= TargetPosition then
            UpdatingPosition = true
            BarFrame.Position = TargetPosition
            UpdatingPosition = false
        end
    end)

    return true
end



