local function CreateSkillToggle(Skill, Order)
	MainTab:Toggle({
		Title = "Auto Skill " .. Skill,
		Default = false,
		Callback = function(Value)
			Settings[Skill] = Value

			if Value then
				StartSkill(Skill)
			else
				StopSkill(Skill)
			end
		end,
	})

	MainTab:Slider({
		Title = "Order " .. Skill,
		Step = 1,
		Value = {
			Min = 1,
			Max = 4,
			Default = Order,
		},
		Callback = function(Value)
			SkillOrder[Skill] = tonumber(Value) or Order
		end,
	})
end

