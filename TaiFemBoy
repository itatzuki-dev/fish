local MinigameSection = MainTab:Section({
    Title = "Minigame",
})

local MinigameEnabled = false
local TEST_INTERVAL = 0.05 -- tối đa khoảng 20 lần/giây; tránh spam RemoteEvent quá mức
local lastFireTime = 0
local testIndex = 1
local ActionEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("BossPhase2Action")

MinigameSection:Toggle({
    Title = "Minigame Enzo & Long DiaoHai",
    Value = false,
    Callback = function(value)
        MinigameEnabled = value
        if value then
        else
        end
    end,
})

RunService.RenderStepped:Connect(function()
    if not MinigameEnabled then
        return
    end

    local Character = LocalPlayer.Character
    if not Character or Character.Parent == nil then
        return
    end

    if Character:GetAttribute("Phase2") ~= true then
        return
    end

    local now = os.clock()
    if now - lastFireTime < TEST_INTERVAL then
        return
    end

    lastFireTime = now

    local payload = {
        Hit = true,
        Index = testIndex,
    }

    local success, err = pcall(function()
        ActionEvent:FireServer(payload)
    end)

    if success then
        testIndex += 1
    else
        warn("[BossPhase2Test] Failed:", err)
    end
end)
