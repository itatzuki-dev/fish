AutoFishSection:Toggle({
    Title = "Auto câu",
    Value = false,
    Callback = function(value)
        AutoFishEnabled = value
        AutoFishTaskId += 1
        local thisTaskId = AutoFishTaskId

        if not value then
            StopAutoFish("người dùng tắt toggle")
            print("[Auto câu] Đã tắt")
            return
        end

        -- Bật Auto câu thì cho phép bắt đầu phiên đầu tiên.
        AutoFishCanCast = true
        print("[Auto câu] Đã bật")
        task.spawn(function()
            while AutoFishEnabled and AutoFishTaskId == thisTaskId do
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local hasToolModel = character and character.Parent and HasToolModel(character)

                if character and character.Parent and root then
                    -- Kiểm tra Tool kể cả khi đang chờ SessionEnd. Nếu mất model, thử hotbar
                    -- theo nhịp giới hạn, đồng thời cho phép bắt đầu lại sau khi trang bị.
                    if not hasToolModel then
                        -- Chưa có model Tool: yêu cầu trang bị lại, rồi để vòng sau kiểm tra lại.
                        AutoFishCanCast = true
                        if os.clock() - LastHotbarToggleAt >= HotbarToggleCooldown then
                            LastHotbarToggleAt = os.clock()
                            local toggleOk, toggleErr = pcall(function()
                                ToggleHotbarEvent:InvokeServer("1", nil)
                            end)
                            if not toggleOk then
                                warn("[Auto câu] ToggleHotbar lỗi:", toggleErr)
                            else
                                task.wait(0.2)
                                -- Kiểm tra lại Character mới sau khi InvokeServer có thể đã yield.
                                character = LocalPlayer.Character
                                root = character and character:FindFirstChild("HumanoidRootPart")
                                hasToolModel = character and character.Parent and HasToolModel(character)
                            end
                        end
                    end

                    -- Khi phát lệnh câu, tiếp tục FireServer cho đến khi Attribute Fishing
                    -- trên Character chuyển thành true. SessionEnd sẽ ngắt vòng retry và mở lượt mới.
                    if character and character.Parent and root and hasToolModel and AutoFishCanCast then
                        AutoFishCanCast = false
                        while AutoFishEnabled and AutoFishTaskId == thisTaskId and not AutoFishCanCast do
                            character = LocalPlayer.Character
                            root = character and character:FindFirstChild("HumanoidRootPart")
                            if not character or not character.Parent or not root then
                                task.wait(AutoFishInterval)
                                continue
                            end

                            local fishingCFrame = root.CFrame * CFrame.new(0, 0, -10)
                            local fishingOk, fishingErr = pcall(function()
                                FishingEvent:FireServer(fishingCFrame)
                            end)
                            if not fishingOk then
                                warn("[Auto câu] Fishing lỗi, sẽ thử lại:", fishingErr)
                            end

                            -- Chờ server cập nhật Attribute sau mỗi lần FireServer.
                            task.wait(0.1)
                            character = LocalPlayer.Character
                            if character and character.Parent and character:GetAttribute("Fishing") == true then
                                break
                            end
                        end
                    end
                end

                task.wait(AutoFishInterval)
            end
        end)
    end,
})

AutoFishSection:Input({
    Title = "Chiêu",
    Placeholder = "Ví dụ: zxcv / z, x, c, v / V-X-C-Z",
    Callback = function(value)
        -- Chấp nhận chữ thường/hoa, viết liền hoặc ngăn cách bằng dấu.
        -- Loại bỏ mọi ký tự ngoài z, x, c, v và giữ đúng thứ tự người chơi nhập.
        local filtered = string.lower(tostring(value or "")):gsub("[^zxcv]", "")
        SkillSequence = filtered:sub(1, 4)
        SkillSequenceVersion += 1
        print("[Auto chiêu] Thứ tự chiêu:", SkillSequence)
    end,
})

AutoFishSection:Toggle({
    Title = "Auto chiêu",
    Value = false,
    Callback = function(value)
        AutoSkillTaskId += 1
        local thisTaskId = AutoSkillTaskId
        AutoSkillEnabled = value

        if not value then
            print("[Auto chiêu] Đã tắt")
            return
        end

        if SkillSequence == "" then
            AutoSkillEnabled = false
            warn("[Auto chiêu] Hãy nhập ít nhất một chữ trong z, x, c, v trước khi bật.")
            return
        end

        task.spawn(function()
            local sequenceIndex = 1
            local activeSequenceVersion = SkillSequenceVersion
            local activeResetVersion = SkillSequenceResetVersion
            while AutoSkillEnabled and AutoSkillTaskId == thisTaskId do
                if activeResetVersion ~= SkillSequenceResetVersion then
                    activeResetVersion = SkillSequenceResetVersion
                    sequenceIndex = 1
                    print("[Auto chiêu] SessionEnd: reset chuỗi về chữ đầu tiên")
                end
                if not SkillLoopArmed or os.clock() < SkillStartAfter then
                    task.wait(0.05)
                    continue
                end

                -- Nếu người chơi sửa chuỗi khi đang chạy, bắt đầu lại từ chữ đầu tiên.
                if activeSequenceVersion ~= SkillSequenceVersion then
                    activeSequenceVersion = SkillSequenceVersion
                    sequenceIndex = 1
                end

                local character = LocalPlayer.Character
                if not character or not character.Parent then
                    task.wait(0.1)
                    continue
                end

                -- LOCK cho phép thử dùng ngay một chiêu kể cả khi SkillLocked chưa cập nhật;
                -- các chiêu kế tiếp vẫn chờ trạng thái khóa được nhả.
                local locked = character:GetAttribute("SkillLocked")
                if locked ~= true or SkillForceNext then
                    SkillForceNext = false
                    local letter = SkillSequence:sub(sequenceIndex, sequenceIndex)
                    if letter == "" then
                        sequenceIndex = 1
                        letter = SkillSequence:sub(sequenceIndex, sequenceIndex)
                    end

                    if letter ~= "" then
                        -- Mỗi lần FireServer chỉ gửi đúng một chữ, ví dụ "Z".
                        local singleSkill = string.upper(letter)
                        local ok, err = pcall(function()
                            UseSkillEvent:FireServer(singleSkill)
                        end)

                        if ok then
                            sequenceIndex += 1
                            if sequenceIndex > #SkillSequence then
                                sequenceIndex = 1
                            end
                            -- Chờ ngắn để xem SkillLocked có chuyển true sau khi dùng chiêu không.
                            -- Nếu không chuyển true trong 0.4 giây, bỏ qua ngay sang chiêu kế tiếp.
                            local sawLocked = false
                            local waitStartedAt = os.clock()
                            while AutoSkillEnabled and AutoSkillTaskId == thisTaskId
                                and os.clock() - waitStartedAt < 0.4 do
                                task.wait(0.05)
                                character = LocalPlayer.Character
                                if not character or not character.Parent then
                                    break
                                end
                                if character:GetAttribute("SkillLocked") == true then
                                    sawLocked = true
                                    break
                                end
                            end

                            if sawLocked then
                                -- Nếu khóa có bật, chờ được nhả rồi mới dùng chiêu tiếp theo.
                                local unlockStartedAt = os.clock()
                                while AutoSkillEnabled and AutoSkillTaskId == thisTaskId
                                    and os.clock() - unlockStartedAt < 3 do
                                    task.wait(0.05)
                                    character = LocalPlayer.Character
                                    if not character or not character.Parent
                                        or character:GetAttribute("SkillLocked") ~= true then
                                        break
                                    end
                                end
                            else
                                print("[Auto chiêu] SkillLocked không chuyển true; chuyển sang chiêu tiếp theo")
                            end
                        else
                            warn("[Auto chiêu] UseSkill lỗi:", err)
                            task.wait(0.2)
                        end
                    end
                else
                    task.wait(0.05)
                end
            end
        end)
    end,
})


--// ANTI AFK
local AntiAfkEnabled = false
local AntiAfkConnection = nil
local AntiAfkSection = OtherTab:Section({
    Title = "Anti AFK",
})

AntiAfkSection:Button({
    Title = "Anti afk",
    Callback = function()
        if AntiAfkEnabled then
            print("[Anti AFK] Đã được bật trước đó")
            return
        end
        AntiAfkEnabled = true

        -- Gỡ event AFK nếu có trong ReplicatedStorage.Events.
        task.spawn(function()
            local ok, err = pcall(function()
                local events = ReplicatedStorage:FindFirstChild("Events")
                local afkEvent = events and events:FindFirstChild("AFK")
                if afkEvent then
                    afkEvent:Destroy()
                    print("[Anti AFK] Đã xóa ReplicatedStorage.Events.AFK ở phía client")
                else
                    print("[Anti AFK] Không tìm thấy Events.AFK hoặc event đã bị xóa")
                end
            end)
            if not ok then
                warn("[Anti AFK] Không thể xóa Events.AFK:", err)
            end
        end)

        -- Chặn trạng thái idle của client bằng thao tác chuột ảo định kỳ.
        task.spawn(function()
            local ok, VirtualUser = pcall(function()
                return game:GetService("VirtualUser")
            end)
            if not ok or not VirtualUser then
                warn("[Anti AFK] VirtualUser không khả dụng trong môi trường này")
                return
            end

            if AntiAfkConnection then
                AntiAfkConnection:Disconnect()
                AntiAfkConnection = nil
            end
            AntiAfkConnection = LocalPlayer.Idled:Connect(function()
                if not AntiAfkEnabled then
                    return
                end
                pcall(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new(0, 0))
                end)
            end)
            print("[Anti AFK] Đã bật")
        end)
    end,
})

--// MINIGAME - Enzo & Long DiaoHai
local MinigameSection = MainTab:Section({
    Title = "Minigame",
})

local MinigameEnabled = false
local TEST_INTERVAL = 0.05 -- tối đa khoảng 20 lần/giây; tránh spam RemoteEvent quá mức
local lastFireTime = 0
local testIndex = 1
local ActionEvent = ReplicatedStorage:WaitForChild("Events"):WaitForChild("BossPhase2Action")

MinigameSection:Toggle({
    Title = "Minigame Enzo & Long DiaoHai",
    Value = false,
    Callback = function(value)
        MinigameEnabled = value
        if value then
            print("[BossPhase2Test] Minigame enabled")
        else
            print("[BossPhase2Test] Minigame disabled")
        end
    end,
})

RunService.RenderStepped:Connect(function()
    if not MinigameEnabled then
        return
    end

    local Character = LocalPlayer.Character
    if not Character or Character.Parent == nil then
        return
    end

    if Character:GetAttribute("Phase2") ~= true then
        return
    end

    local now = os.clock()
    if now - lastFireTime < TEST_INTERVAL then
        return
    end

    lastFireTime = now

    local payload = {
        Hit = true,
        Index = testIndex,
    }

    local success, err = pcall(function()
        ActionEvent:FireServer(payload)
    end)

    if success then
        print("[BossPhase2Test] Sent:", payload.Hit, payload.Index)
        testIndex += 1
    else
        warn("[BossPhase2Test] Failed:", err)
    end
end)
