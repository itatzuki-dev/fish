--// AUTO CÂU
local AutoFishEnabled = false
local AutoFishTaskId = 0
local AutoFishInterval = 0.1
-- Chỉ phát lệnh Fishing một lần mỗi phiên; SessionEnd mở khóa lần câu kế tiếp.
local AutoFishCanCast = true
local LastHotbarToggleAt = 0
local HotbarToggleCooldown = 0.75
local EventsFolder = ReplicatedStorage:WaitForChild("Events")
local ToggleHotbarEvent = EventsFolder:WaitForChild("ToggleHotbar")
local FishingEvent = EventsFolder:WaitForChild("Fishing")
local FishingMinigameEvent = EventsFolder:WaitForChild("FishingMinigame")
local ReadyTimeFXEvent = EventsFolder:WaitForChild("ReadyTimeFX")

-- Tìm Model tên Tool cả trong descendants của Character.
local function HasToolModel(character)
    if not character then
        return false
    end

    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("Model") and descendant.Name == "Tool" then
            return true
        end
    end
    return false
end

local function StopAutoFish(reason)
    local wasEnabled = AutoFishEnabled
    AutoFishEnabled = false
    AutoFishTaskId += 1

    if wasEnabled then
        local unequipOk, unequipErr = pcall(function()
            FishingMinigameEvent:FireServer(false, "", "Unequip")
        end)
        if not unequipOk then
            warn("[Auto câu] Unequip lỗi:", unequipErr)
        end
        print("[Auto câu] Đã dừng:", reason or "không rõ lý do")
    end
end

-- Auto chiêu tạm nghỉ khi SessionEnd và tự chạy lại khi nhận LOCK tiếp theo.
local AutoSkillEnabled = false
local SkillSequence = ""
local SkillSequenceVersion = 0
local AutoSkillTaskId = 0
local UseSkillEvent = EventsFolder:WaitForChild("UseSkill")
local SkillLoopArmed = false
local SkillForceNext = false
-- Tăng sau mỗi SessionEnd để vòng Auto chiêu reset về chữ đầu tiên.
local SkillSequenceResetVersion = 0

-- Sau LOCK, đợi đủ 1 giây rồi mới cho phép Auto chiêu chạy.
local SkillStartAfter = 0
local ReadyTimeFXConnection = ReadyTimeFXEvent.OnClientEvent:Connect(function(state)
    if state == "LOCK" then
        SkillLoopArmed = true
        SkillForceNext = true
        SkillStartAfter = os.clock() + 1
        print("[Auto chiêu] Đã nhận LOCK; sẽ bắt đầu sau 1 giây")
    end
end)

local function StopAutoSkill(reason)
    if AutoSkillEnabled then
        AutoSkillEnabled = false
        AutoSkillTaskId += 1
        print("[Auto chiêu] Đã dừng:", reason or "không rõ lý do")
    end
end

local FishingMinigameConnection = FishingMinigameEvent.OnClientEvent:Connect(function(state, success)
    if state == "SessionEnd" then
        -- Chỉ cho phép Auto câu phát lệnh câu tiếp sau khi phiên hiện tại kết thúc.
        AutoFishCanCast = true

        -- Auto chiêu tạm nghỉ đến khi nhận LOCK kế tiếp.
        SkillLoopArmed = false
        SkillForceNext = false
        SkillSequenceResetVersion += 1
        print("[Auto câu] SessionEnd nhận được; sẵn sàng bắt đầu phiên câu tiếp theo")
        print("[Auto chiêu] Tạm nghỉ, chờ LOCK tiếp theo")
    end
    -- Bỏ qua Out of bar và Dead theo yêu cầu.
end)

local AutoFishSection = MainTab:Section({
    Title = "Fishing",
})

AutoFishSection:Toggle({
    Title = "Freeze bar",
