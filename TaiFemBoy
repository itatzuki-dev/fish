        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local mainGui = playerGui and playerGui:FindFirstChild("MainGui")
        local menu = mainGui and mainGui:FindFirstChild("Menu")
        local dialogue = menu and menu:FindFirstChild("Dialogue")
        if dialogue then
            dialogue.Visible = false
        end
    end)
end
local AutoHardQuestEnabled = false
local AutoHardQuestTaskId = 0
local AutoTurnInQuestEnabled = false
local AutoTurnInQuestTaskId = 0
local DialogueSuppressTaskId = 0
local QUEST_SCAN_INTERVAL = 3

-- Ẩn Dialogue liên tục khi một trong hai toggle nhiệm vụ đang bật.
-- Điều này xử lý cả trường hợp giao diện xuất hiện trễ sau FireServer.
local function StartDialogueSuppressor()
    DialogueSuppressTaskId += 1
    local thisSuppressTaskId = DialogueSuppressTaskId
    task.spawn(function()
        while DialogueSuppressTaskId == thisSuppressTaskId
            and (AutoHardQuestEnabled or AutoTurnInQuestEnabled) do
            HideDialogueFrame()
            task.wait(0.05)
        end
        HideDialogueFrame()
    end)
end

local function GetHardQuestFrame()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    local mainGui = playerGui and playerGui:FindFirstChild("MainGui")
    local menu = mainGui and mainGui:FindFirstChild("Menu")
    local questMenu = menu and menu:FindFirstChild("Quest")
    local questRoot = questMenu and questMenu:FindFirstChild("Menu")
    local mainQuest = questRoot and questRoot:FindFirstChild("Main_Quest")
    if not mainQuest then
        return nil
    end
    return mainQuest, mainQuest:FindFirstChild("Hard Ticket Quest")
end

local function FireHardQuestDialogue()
    local success, err = pcall(function()
        local npcFunction = workspace:WaitForChild("NPC")
            :WaitForChild("Function")
            :WaitForChild("Ticket Quest Giver")

        ChooseDialogueOptionEvent:FireServer(
            "Ticket Quest Giver",
            2,
            "HardAcceptQuest",
            {
                npcFunction,
                "Ticket Quest"
            }
        )
        HideDialogueFrame()
    end)

    if not success then
        warn("[Auto nhiệm vụ khó] Lỗi:", err)
    end
end

local function FireTurnInQuestDialogue()
